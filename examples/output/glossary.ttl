@prefix bank: <http://ontobridge.dev/ontology/bank/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rel: <http://ontobridge.dev/ontology/bank/relations/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

bank:AMLScreening a skos:Concept ;
    dcterms:source <policy:sample_policy.txt> ;
    skos:definition "the process of monitoring customer transactions and behaviour to detect and report activities that may constitute money laundering or the financing of terrorism, as required by applicable anti-money laundering regulations."@en ;
    skos:editorialNote "Generated by OntoBridge pipeline"@en ;
    skos:prefLabel "AML screening"@en .

bank:Collateral a skos:Concept ;
    dcterms:source <policy:sample_policy.txt> ;
    skos:definition "an asset pledged by a borrower to a lender as security against a loan obligation, allowing the lender to seize the asset in the event of default."@en ;
    skos:editorialNote "Generated by OntoBridge pipeline"@en ;
    skos:prefLabel "Collateral"@en .

bank:CreditScore a skos:Concept ;
    rel:evaluates "the likelihood of loan repayment"@en ;
    dcterms:source <policy:sample_policy.txt> ;
    skos:broader bank:CreditCheck ;
    skos:definition "a numerical rating assigned to a borrower based on their credit history, repayment behaviour, and financial profile, used by lenders to evaluate the likelihood of loan repayment."@en ;
    skos:editorialNote "Generated by OntoBridge pipeline"@en ;
    skos:inScheme bank:SchemeProcess ;
    skos:prefLabel "Credit score"@en .

bank:KYCVerificationProcess a skos:Concept ;
    rel:requires "the bank to"@en ;
    dcterms:source <policy:sample_policy.txt> ;
    skos:broader bank:KYC ;
    skos:definition "the mandatory regulatory procedure that requires the bank to verify the identity and risk profile of each customer before establishing a banking relationship or processing high-value transactions."@en ;
    skos:editorialNote "Generated by OntoBridge pipeline"@en ;
    skos:inScheme bank:SchemeProcess ;
    skos:prefLabel "KYC verification process"@en .

bank:LoanToValueRatio a skos:Concept ;
    dcterms:source <policy:sample_policy.txt> ;
    skos:broader bank:LoanApplication ;
    skos:definition "the financial metric that expresses the ratio of the outstanding loan amount to the appraised market value of the collateral property, used by lenders to assess credit risk before approving a mortgage application."@en ;
    skos:editorialNote "Generated by OntoBridge pipeline"@en ;
    skos:inScheme bank:SchemeProcess ;
    skos:prefLabel "Loan-to-Value ratio"@en .

bank:Mortgage a skos:Concept ;
    dcterms:source <policy:sample_policy.txt> ;
    skos:definition "a loan secured by real property in which the borrower pledges the asset as collateral to the lender until the loan is fully repaid."@en ;
    skos:editorialNote "Generated by OntoBridge pipeline"@en ;
    skos:prefLabel "Mortgage"@en .

bank:NetInterestMargin a skos:Concept ;
    skos:definition "Net interest margin is the difference between the interest income generated by a bank and the interest paid to depositors, expressed as a percentage of interest-earning assets."@en ;
    skos:editorialNote "Generated by OntoBridge pipeline"@en ;
    skos:prefLabel "Net interest margin"@en .

bank:Overdraft a skos:Concept ;
    dcterms:source <policy:sample_policy.txt> ;
    skos:definition "a credit facility provided by a bank that allows an account holder to withdraw funds beyond the available account balance up to a pre-agreed limit, subject to interest charges on the overdrawn amount."@en ;
    skos:editorialNote "Generated by OntoBridge pipeline"@en ;
    skos:prefLabel "Overdraft"@en .

bank:SEPATransfer a skos:Concept ;
    dcterms:source <policy:sample_policy.txt> ;
    skos:definition "a euro-denominated payment transaction executed within the Single Euro Payments Area, subject to standardised processing times and fee structures established by the European Payments Council."@en ;
    skos:editorialNote "Generated by OntoBridge pipeline"@en ;
    skos:prefLabel "SEPA transfer"@en .

bank:SWIFTMessage a skos:Concept ;
    dcterms:source <policy:sample_policy.txt> ;
    skos:definition "a standardised financial communication sent through the Society for Worldwide Interbank Financial Telecommunication network to facilitate cross-border payment instructions between correspondent banks."@en ;
    skos:editorialNote "Generated by OntoBridge pipeline"@en ;
    skos:prefLabel "SWIFT message"@en .

<http://ontobridge.dev/ontology/glossary/> a owl:Ontology ;
    rdfs:label "OntoBridge Term Glossary"@en ;
    dc:date "2026-05-06"^^xsd:date ;
    dc:description "Auto-exported by OntoBridge. Contains 10 term(s) with status: published, review, draft, candidate, deprecated."@en .

