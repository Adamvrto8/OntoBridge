##############################################################################
# OntoBridge — Domain Ontology (Draft v0.1)
#
# Multi-Agent Semantic Term Governance System
# Domain: Retail Banking (Personal Instalment & Micro segments)
#
# Standards: SKOS (taxonomy + labels), OWL (semantic relations), 
#            Dublin Core (provenance), FIBO (industry bridging)
#
# This is a working draft. Terms at level 3+ will be populated by the
# pipeline once data sources are connected. The upper structure (schemes,
# level 1-2 concepts, FIBO bridges, verb lexicon) is stable.
##############################################################################


# ==========================================================================
# NAMESPACE DECLARATIONS
# ==========================================================================

@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:      <http://purl.org/dc/terms/> .
@prefix schema:   <https://schema.org/> .

# FIBO namespaces (EDM Council — Financial Industry Business Ontology)
@prefix fibo-fnd-pty:  <https://spec.edmcouncil.org/fibo/ontology/FND/Parties/Parties/> .
@prefix fibo-fnd-agr:  <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/> .
@prefix fibo-fnd-arr:  <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Documents/> .
@prefix fibo-fbc-pas:  <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/> .
@prefix fibo-loan:     <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoanTypes/LoanTypes/> .

# OntoBridge domain namespace
@prefix bank:     <http://ontobridge.dev/ontology/bank/> .
@prefix bank-rel: <http://ontobridge.dev/ontology/bank/relations/> .


# ==========================================================================
# ONTOLOGY METADATA
# ==========================================================================

<http://ontobridge.dev/ontology/bank/>
    a owl:Ontology ;
    dct:title "OntoBridge — Retail Banking Domain Ontology"@en ;
    dct:description "SKOS/OWL ontology for governing business terms in the retail banking domain, covering customer segments, credit products, processes, risk assessment, documents, and channels. Bridges to FIBO and Schema.org."@en ;
    dct:created "2026-05-01"^^xsd:date ;
    dct:creator "OntoBridge Team" ;
    owl:versionInfo "0.1-draft" ;
    rdfs:comment "Working draft — upper structure stable, leaf terms to be populated by pipeline."@en .


# ==========================================================================
# CONCEPT SCHEMES (top-level domain groupings)
# ==========================================================================

bank:SchemeParty
    a skos:ConceptScheme ;
    skos:prefLabel "Party / Customer"@en ;
    dct:description "Parties involved in banking relationships — customers, counterparties, and their segment classifications."@en .

bank:SchemeProduct
    a skos:ConceptScheme ;
    skos:prefLabel "Financial Product"@en ;
    dct:description "Banking products offered to customers — credit, deposit, insurance, and payment products."@en .

bank:SchemeProcess
    a skos:ConceptScheme ;
    skos:prefLabel "Process"@en ;
    dct:description "Business processes in retail banking — application, verification, underwriting, servicing."@en .

bank:SchemeRisk
    a skos:ConceptScheme ;
    skos:prefLabel "Risk Assessment"@en ;
    dct:description "Risk evaluation concepts — scoring models, underwriting profiles, risk categories."@en .

bank:SchemeDocument
    a skos:ConceptScheme ;
    skos:prefLabel "Document"@en ;
    dct:description "Documents used in banking processes — policies, contracts, regulatory filings, internal reports."@en .

bank:SchemeChannel
    a skos:ConceptScheme ;
    skos:prefLabel "Channel"@en ;
    dct:description "Customer interaction channels — digital, branch, call centre, partner."@en .


# ==========================================================================
# SCHEME 1: PARTY / CUSTOMER
# ==========================================================================

# --- Level 1: Top concept ---

bank:Customer
    a skos:Concept ;
    skos:inScheme bank:SchemeParty ;
    skos:topConceptOf bank:SchemeParty ;
    skos:prefLabel "Customer"@en ;
    skos:definition "A party that holds or is eligible to hold one or more financial products with the bank."@en ;
    skos:exactMatch fibo-fnd-pty:PartyInRole ;
    skos:closeMatch schema:Person .

# --- Level 2: Segment categories ---

bank:RetailCustomer
    a skos:Concept ;
    skos:inScheme bank:SchemeParty ;
    skos:broader bank:Customer ;
    skos:prefLabel "Retail customer"@en ;
    skos:altLabel "Individual customer"@en ;
    skos:definition "A natural person who holds retail banking products for personal or household use."@en .

bank:CorporateCustomer
    a skos:Concept ;
    skos:inScheme bank:SchemeParty ;
    skos:broader bank:Customer ;
    skos:prefLabel "Corporate customer"@en ;
    skos:altLabel "Business customer"@en ;
    skos:definition "A legal entity that holds commercial banking products for business purposes."@en .

# --- Level 3: Specific segments ---

bank:RetailPICustomer
    a skos:Concept ;
    skos:inScheme bank:SchemeParty ;
    skos:broader bank:RetailCustomer ;
    skos:prefLabel "Retail PI customer"@en ;
    skos:altLabel "PI customer"@en ;
    skos:definition "A retail customer in the Personal Instalment segment who holds or is eligible for instalment-based credit products."@en .

bank:RetailMicroCustomer
    a skos:Concept ;
    skos:inScheme bank:SchemeParty ;
    skos:broader bank:RetailCustomer ;
    skos:prefLabel "Retail Micro customer"@en ;
    skos:altLabel "Micro customer"@en ;
    skos:definition "A retail customer in the Micro segment, typically a sole trader or micro-enterprise served through the retail channel."@en .

bank:SMECustomer
    a skos:Concept ;
    skos:inScheme bank:SchemeParty ;
    skos:broader bank:CorporateCustomer ;
    skos:prefLabel "SME customer"@en ;
    skos:altLabel "Small business customer"@en ;
    skos:definition "A small or medium-sized enterprise customer served through the corporate banking channel."@en .


# ==========================================================================
# SCHEME 2: FINANCIAL PRODUCT
# ==========================================================================

# --- Level 1: Top concept ---

bank:FinancialProduct
    a skos:Concept ;
    skos:inScheme bank:SchemeProduct ;
    skos:topConceptOf bank:SchemeProduct ;
    skos:prefLabel "Financial product"@en ;
    skos:definition "A product or service offered by the bank to its customers."@en ;
    skos:exactMatch fibo-fbc-pas:FinancialProduct ;
    skos:closeMatch schema:FinancialProduct .

# --- Level 2: Product categories ---

bank:CreditProduct
    a skos:Concept ;
    skos:inScheme bank:SchemeProduct ;
    skos:broader bank:FinancialProduct ;
    skos:prefLabel "Credit product"@en ;
    skos:altLabel "Lending product"@en ;
    skos:definition "A financial product that provides credit to a customer, creating a repayment obligation."@en .

bank:DepositProduct
    a skos:Concept ;
    skos:inScheme bank:SchemeProduct ;
    skos:broader bank:FinancialProduct ;
    skos:prefLabel "Deposit product"@en ;
    skos:definition "A financial product that allows a customer to deposit and hold funds with the bank."@en .

# --- Level 3: Specific products ---

bank:PILoan
    a skos:Concept ;
    skos:inScheme bank:SchemeProduct ;
    skos:broader bank:CreditProduct ;
    skos:prefLabel "Personal instalment loan"@en ;
    skos:altLabel "PI loan"@en ;
    skos:definition "A fixed-term credit product repaid in regular instalments, offered to retail PI customers."@en ;
    skos:exactMatch fibo-loan:Loan .

bank:MicroLoan
    a skos:Concept ;
    skos:inScheme bank:SchemeProduct ;
    skos:broader bank:CreditProduct ;
    skos:prefLabel "Micro loan"@en ;
    skos:definition "A small-value credit product designed for micro-segment customers and sole traders."@en .

bank:SavingsAccount
    a skos:Concept ;
    skos:inScheme bank:SchemeProduct ;
    skos:broader bank:DepositProduct ;
    skos:prefLabel "Savings account"@en ;
    skos:definition "A deposit account that accrues interest on the balance held."@en ;
    skos:closeMatch schema:BankAccount .

bank:CurrentAccount
    a skos:Concept ;
    skos:inScheme bank:SchemeProduct ;
    skos:broader bank:DepositProduct ;
    skos:prefLabel "Current account"@en ;
    skos:altLabel "Checking account"@en ;
    skos:definition "A transactional deposit account used for day-to-day payments and receipts."@en .


# ==========================================================================
# SCHEME 3: PROCESS
# ==========================================================================

# --- Level 1: Top concept ---

bank:Process
    a skos:Concept ;
    skos:inScheme bank:SchemeProcess ;
    skos:topConceptOf bank:SchemeProcess ;
    skos:prefLabel "Process"@en ;
    skos:definition "A structured sequence of activities performed by the bank or its systems to achieve a business outcome."@en ;
    skos:closeMatch schema:Action .

# --- Level 2: Process categories ---

bank:ApplicationProcess
    a skos:Concept ;
    skos:inScheme bank:SchemeProcess ;
    skos:broader bank:Process ;
    skos:prefLabel "Application process"@en ;
    skos:definition "The end-to-end process through which a customer applies for a financial product."@en .

bank:VerificationProcess
    a skos:Concept ;
    skos:inScheme bank:SchemeProcess ;
    skos:broader bank:Process ;
    skos:prefLabel "Verification process"@en ;
    skos:definition "A process that validates customer identity, eligibility, or documentation."@en .

bank:ServicingProcess
    a skos:Concept ;
    skos:inScheme bank:SchemeProcess ;
    skos:broader bank:Process ;
    skos:prefLabel "Servicing process"@en ;
    skos:definition "Ongoing processes related to managing an active product — payments, modifications, collections."@en .

# --- Level 3: Specific processes ---

bank:LoanApplication
    a skos:Concept ;
    skos:inScheme bank:SchemeProcess ;
    skos:broader bank:ApplicationProcess ;
    skos:prefLabel "Loan application"@en ;
    skos:definition "The process of submitting, evaluating, and deciding on a customer's request for a credit product."@en .

bank:KYC
    a skos:Concept ;
    skos:inScheme bank:SchemeProcess ;
    skos:broader bank:VerificationProcess ;
    skos:prefLabel "KYC"@en ;
    skos:altLabel "Know your customer"@en ;
    skos:definition "The regulatory process of verifying a customer's identity and assessing risk prior to onboarding."@en .

bank:CreditCheck
    a skos:Concept ;
    skos:inScheme bank:SchemeProcess ;
    skos:broader bank:VerificationProcess ;
    skos:prefLabel "Credit check"@en ;
    skos:altLabel "Credit assessment"@en ;
    skos:definition "The evaluation of a customer's creditworthiness based on internal and external data sources."@en .


# ==========================================================================
# SCHEME 4: RISK ASSESSMENT
# ==========================================================================

# --- Level 1: Top concept ---

bank:RiskAssessment
    a skos:Concept ;
    skos:inScheme bank:SchemeRisk ;
    skos:topConceptOf bank:SchemeRisk ;
    skos:prefLabel "Risk assessment"@en ;
    skos:definition "The evaluation of risk associated with a customer, product, or transaction."@en ;
    skos:closeMatch <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/RiskAnalysis> .

# --- Level 2 ---

bank:CreditScore
    a skos:Concept ;
    skos:inScheme bank:SchemeRisk ;
    skos:broader bank:RiskAssessment ;
    skos:prefLabel "Credit score"@en ;
    skos:definition "A numerical score representing a customer's creditworthiness, derived from credit bureau data and internal models."@en .

bank:UWProfile
    a skos:Concept ;
    skos:inScheme bank:SchemeRisk ;
    skos:broader bank:RiskAssessment ;
    skos:prefLabel "Underwriting profile"@en ;
    skos:altLabel "UW profile"@en ;
    skos:definition "A composite risk profile used by the underwriting engine to determine product eligibility and pricing."@en .

# --- Level 3 ---

bank:MicroUWProfile
    a skos:Concept ;
    skos:inScheme bank:SchemeRisk ;
    skos:broader bank:UWProfile ;
    skos:prefLabel "Micro UW profile"@en ;
    skos:definition "An underwriting profile specific to the Micro customer segment, with adapted risk thresholds and scoring criteria."@en .


# ==========================================================================
# SCHEME 5: DOCUMENT
# ==========================================================================

# --- Level 1: Top concept ---

bank:Document
    a skos:Concept ;
    skos:inScheme bank:SchemeDocument ;
    skos:topConceptOf bank:SchemeDocument ;
    skos:prefLabel "Document"@en ;
    skos:definition "A recorded artifact — physical or digital — that contains information relevant to banking operations."@en ;
    skos:closeMatch fibo-fnd-arr:Document .

# --- Level 2 ---

bank:PolicyDocument
    a skos:Concept ;
    skos:inScheme bank:SchemeDocument ;
    skos:broader bank:Document ;
    skos:prefLabel "Policy document"@en ;
    skos:definition "An internal document that defines rules, procedures, and guidelines governing banking operations."@en .

bank:Contract
    a skos:Concept ;
    skos:inScheme bank:SchemeDocument ;
    skos:broader bank:Document ;
    skos:prefLabel "Contract"@en ;
    skos:altLabel "Agreement"@en ;
    skos:definition "A legally binding document between the bank and a customer or counterparty."@en ;
    skos:exactMatch fibo-fnd-agr:Contract .

bank:RegulatoryFiling
    a skos:Concept ;
    skos:inScheme bank:SchemeDocument ;
    skos:broader bank:Document ;
    skos:prefLabel "Regulatory filing"@en ;
    skos:definition "A document submitted to a regulatory authority in compliance with legal requirements."@en .


# ==========================================================================
# SCHEME 6: CHANNEL
# ==========================================================================

# --- Level 1: Top concept ---

bank:Channel
    a skos:Concept ;
    skos:inScheme bank:SchemeChannel ;
    skos:topConceptOf bank:SchemeChannel ;
    skos:prefLabel "Channel"@en ;
    skos:definition "A medium through which customers interact with the bank to access products and services."@en ;
    skos:closeMatch schema:ServiceChannel .

# --- Level 2 ---

bank:MobileApp
    a skos:Concept ;
    skos:inScheme bank:SchemeChannel ;
    skos:broader bank:Channel ;
    skos:prefLabel "Mobile app"@en ;
    skos:altLabel "Mobile banking"@en ;
    skos:definition "A smartphone application provided by the bank for account management, payments, and product applications."@en .

bank:Branch
    a skos:Concept ;
    skos:inScheme bank:SchemeChannel ;
    skos:broader bank:Channel ;
    skos:prefLabel "Branch"@en ;
    skos:altLabel "Physical branch"@en ;
    skos:definition "A physical banking location where customers can access services in person."@en .

bank:OnlineBanking
    a skos:Concept ;
    skos:inScheme bank:SchemeChannel ;
    skos:broader bank:Channel ;
    skos:prefLabel "Online banking"@en ;
    skos:altLabel "Internet banking"@en ;
    skos:definition "The bank's web-based platform for account access and transaction management."@en .

bank:CallCentre
    a skos:Concept ;
    skos:inScheme bank:SchemeChannel ;
    skos:broader bank:Channel ;
    skos:prefLabel "Call centre"@en ;
    skos:altLabel "Contact centre"@en ;
    skos:definition "A telephone-based service channel for customer inquiries, support, and product applications."@en .


# ==========================================================================
# SEMANTIC RELATIONS (OWL Object Properties + inverses)
# ==========================================================================
# These are the bidirectional verb pairs from the inverse verb lexicon.
# The Relations agent will populate instances of these properties.
# ==========================================================================

# --- submits / submittedBy ---
bank-rel:submits
    a owl:ObjectProperty ;
    rdfs:label "submits"@en ;
    rdfs:comment "A party submits a request, application, or document."@en ;
    rdfs:domain bank:Customer ;
    rdfs:range bank:LoanApplication ;
    owl:inverseOf bank-rel:submittedBy .

bank-rel:submittedBy
    a owl:ObjectProperty ;
    rdfs:label "submitted by"@en ;
    rdfs:comment "An application or document is submitted by a party."@en ;
    owl:inverseOf bank-rel:submits .

# --- uses / usedBy ---
bank-rel:uses
    a owl:ObjectProperty ;
    rdfs:label "uses"@en ;
    rdfs:comment "A party uses a channel, product, or system."@en ;
    owl:inverseOf bank-rel:usedBy .

bank-rel:usedBy
    a owl:ObjectProperty ;
    rdfs:label "used by"@en ;
    owl:inverseOf bank-rel:uses .

# --- holds / heldBy ---
bank-rel:holds
    a owl:ObjectProperty ;
    rdfs:label "holds"@en ;
    rdfs:comment "A customer holds a financial product."@en ;
    rdfs:domain bank:Customer ;
    rdfs:range bank:FinancialProduct ;
    owl:inverseOf bank-rel:heldBy .

bank-rel:heldBy
    a owl:ObjectProperty ;
    rdfs:label "held by"@en ;
    owl:inverseOf bank-rel:holds .

# --- evaluates / evaluatedBy ---
bank-rel:evaluates
    a owl:ObjectProperty ;
    rdfs:label "evaluates"@en ;
    rdfs:comment "A process or assessment evaluates a party or application."@en ;
    owl:inverseOf bank-rel:evaluatedBy .

bank-rel:evaluatedBy
    a owl:ObjectProperty ;
    rdfs:label "evaluated by"@en ;
    owl:inverseOf bank-rel:evaluates .

# --- requires / requiredBy ---
bank-rel:requires
    a owl:ObjectProperty ;
    rdfs:label "requires"@en ;
    rdfs:comment "A product or process requires a verification, document, or condition."@en ;
    owl:inverseOf bank-rel:requiredBy .

bank-rel:requiredBy
    a owl:ObjectProperty ;
    rdfs:label "required by"@en ;
    owl:inverseOf bank-rel:requires .

# --- produces / producedBy ---
bank-rel:produces
    a owl:ObjectProperty ;
    rdfs:label "produces"@en ;
    rdfs:comment "A process produces an output — a score, a decision, a document."@en ;
    owl:inverseOf bank-rel:producedBy .

bank-rel:producedBy
    a owl:ObjectProperty ;
    rdfs:label "produced by"@en ;
    owl:inverseOf bank-rel:produces .

# --- governs / governedBy ---
bank-rel:governs
    a owl:ObjectProperty ;
    rdfs:label "governs"@en ;
    rdfs:comment "A policy or rule governs a process, product, or decision."@en ;
    owl:inverseOf bank-rel:governedBy .

bank-rel:governedBy
    a owl:ObjectProperty ;
    rdfs:label "governed by"@en ;
    owl:inverseOf bank-rel:governs .

# --- triggers / triggeredBy ---
bank-rel:triggers
    a owl:ObjectProperty ;
    rdfs:label "triggers"@en ;
    rdfs:comment "An event or action triggers a process or assessment."@en ;
    owl:inverseOf bank-rel:triggeredBy .

bank-rel:triggeredBy
    a owl:ObjectProperty ;
    rdfs:label "triggered by"@en ;
    owl:inverseOf bank-rel:triggers .


# ==========================================================================
# SAMPLE RELATION INSTANCES
# ==========================================================================
# These demonstrate how the Relations agent would populate triples.
# In production, the agent generates these automatically.
# ==========================================================================

bank:RetailPICustomer  bank-rel:submits     bank:LoanApplication .
bank:RetailPICustomer  bank-rel:holds       bank:PILoan .
bank:RetailPICustomer  bank-rel:uses        bank:MobileApp .
bank:CreditCheck       bank-rel:evaluates   bank:RetailPICustomer .
bank:CreditCheck       bank-rel:produces    bank:CreditScore .
bank:PILoan            bank-rel:requires    bank:CreditCheck .
bank:PILoan            bank-rel:requires    bank:KYC .
bank:PolicyDocument    bank-rel:governs     bank:LoanApplication .
bank:LoanApplication   bank-rel:triggers    bank:CreditCheck .


# ==========================================================================
# EXPANSION v0.2 — Additional banking concepts
# 35 new concepts across all 6 schemes
# ==========================================================================


# --------------------------------------------------------------------------
# SCHEME 1 (continued): PARTY — compliance roles
# --------------------------------------------------------------------------

bank:Guarantor
    a skos:Concept ;
    skos:inScheme bank:SchemeParty ;
    skos:broader bank:Customer ;
    skos:prefLabel "Guarantor"@en ;
    skos:altLabel "Surety"@en, "Co-guarantor"@en ;
    skos:definition "A party who undertakes to repay a borrower's debt if the borrower defaults on the credit obligation."@en .

bank:CoBorrower
    a skos:Concept ;
    skos:inScheme bank:SchemeParty ;
    skos:broader bank:Customer ;
    skos:prefLabel "Co-borrower"@en ;
    skos:altLabel "Joint borrower"@en, "Co-applicant"@en ;
    skos:definition "A secondary borrower who shares equal legal responsibility for repaying a credit product alongside the primary borrower."@en .

bank:BeneficialOwner
    a skos:Concept ;
    skos:inScheme bank:SchemeParty ;
    skos:broader bank:CorporateCustomer ;
    skos:prefLabel "Beneficial owner"@en ;
    skos:altLabel "Ultimate beneficial owner"@en, "UBO"@en ;
    skos:definition "A natural person who ultimately owns or exercises effective control over a legal entity customer, as defined by AML regulations."@en .

bank:PEP
    a skos:Concept ;
    skos:inScheme bank:SchemeParty ;
    skos:broader bank:Customer ;
    skos:prefLabel "Politically exposed person"@en ;
    skos:altLabel "PEP"@en ;
    skos:definition "A natural person who holds or has held a prominent public function, subject to enhanced due diligence requirements under AML law."@en .


# --------------------------------------------------------------------------
# SCHEME 2 (continued): FINANCIAL PRODUCT — additional products
# --------------------------------------------------------------------------

bank:ConsumerLoan
    a skos:Concept ;
    skos:inScheme bank:SchemeProduct ;
    skos:broader bank:CreditProduct ;
    skos:prefLabel "Consumer loan"@en ;
    skos:altLabel "Personal loan"@en, "Retail loan"@en ;
    skos:definition "An unsecured credit product granted to a retail customer for personal expenditure, not tied to a specific asset purchase."@en .

bank:Mortgage
    a skos:Concept ;
    skos:inScheme bank:SchemeProduct ;
    skos:broader bank:CreditProduct ;
    skos:prefLabel "Mortgage"@en ;
    skos:altLabel "Home loan"@en, "Mortgage loan"@en, "Housing loan"@en ;
    skos:definition "A long-term secured credit product in which real estate property serves as collateral for the loan obligation."@en .

bank:Overdraft
    a skos:Concept ;
    skos:inScheme bank:SchemeProduct ;
    skos:broader bank:CreditProduct ;
    skos:prefLabel "Overdraft"@en ;
    skos:altLabel "Current account overdraft"@en, "Arranged overdraft"@en ;
    skos:definition "A short-term credit facility allowing a customer's current account balance to fall below zero up to an approved limit."@en .

bank:CreditCard
    a skos:Concept ;
    skos:inScheme bank:SchemeProduct ;
    skos:broader bank:CreditProduct ;
    skos:prefLabel "Credit card"@en ;
    skos:altLabel "Revolving credit card"@en ;
    skos:definition "A revolving credit product that allows customers to make purchases or cash advances up to a defined credit limit, with a minimum monthly repayment."@en .

bank:TermDeposit
    a skos:Concept ;
    skos:inScheme bank:SchemeProduct ;
    skos:broader bank:DepositProduct ;
    skos:prefLabel "Term deposit"@en ;
    skos:altLabel "Fixed deposit"@en, "Time deposit"@en ;
    skos:definition "A deposit product held for a fixed term at an agreed interest rate, not accessible before maturity without early-withdrawal penalty."@en .


# --------------------------------------------------------------------------
# SCHEME 3 (continued): PROCESS — compliance and servicing processes
# --------------------------------------------------------------------------

bank:AMLProcess
    a skos:Concept ;
    skos:inScheme bank:SchemeProcess ;
    skos:broader bank:VerificationProcess ;
    skos:prefLabel "Anti-money laundering"@en ;
    skos:altLabel "AML"@en, "AML process"@en, "Money laundering prevention"@en ;
    skos:definition "The set of policies, controls, and procedures used to detect, prevent, and report money laundering and terrorist financing activities."@en .

bank:CDD
    a skos:Concept ;
    skos:inScheme bank:SchemeProcess ;
    skos:broader bank:VerificationProcess ;
    skos:prefLabel "Customer due diligence"@en ;
    skos:altLabel "CDD"@en, "Due diligence"@en ;
    skos:definition "The process of identifying and verifying a customer's identity and assessing the risk level of the business relationship for AML compliance purposes."@en .

bank:EDD
    a skos:Concept ;
    skos:inScheme bank:SchemeProcess ;
    skos:broader bank:CDD ;
    skos:prefLabel "Enhanced due diligence"@en ;
    skos:altLabel "EDD"@en ;
    skos:definition "Heightened due diligence measures applied to high-risk customers such as PEPs, customers from high-risk jurisdictions, or complex ownership structures."@en .

bank:SanctionsScreening
    a skos:Concept ;
    skos:inScheme bank:SchemeProcess ;
    skos:broader bank:VerificationProcess ;
    skos:prefLabel "Sanctions screening"@en ;
    skos:altLabel "Sanctions check"@en, "Watchlist screening"@en ;
    skos:definition "The automated or manual process of checking customers, transactions, and counterparties against regulatory sanctions lists and watchlists."@en .

bank:CustomerOnboarding
    a skos:Concept ;
    skos:inScheme bank:SchemeProcess ;
    skos:broader bank:ApplicationProcess ;
    skos:prefLabel "Customer onboarding"@en ;
    skos:altLabel "Onboarding"@en, "Account opening"@en ;
    skos:definition "The end-to-end process of accepting a new customer, encompassing identity verification, risk assessment, and activation of products or accounts."@en .

bank:Underwriting
    a skos:Concept ;
    skos:inScheme bank:SchemeProcess ;
    skos:broader bank:ApplicationProcess ;
    skos:prefLabel "Underwriting"@en ;
    skos:altLabel "Credit underwriting"@en, "Loan underwriting"@en ;
    skos:definition "The process of evaluating the financial risk of a credit application and determining approval, rejection, or conditional terms."@en .

bank:CreditDecision
    a skos:Concept ;
    skos:inScheme bank:SchemeProcess ;
    skos:broader bank:ApplicationProcess ;
    skos:prefLabel "Credit decision"@en ;
    skos:altLabel "Loan decision"@en, "Credit approval"@en, "Credit rejection"@en ;
    skos:definition "The formal outcome of the underwriting process — approval, conditional approval, or rejection — communicated to the applicant."@en .

bank:LoanDisbursement
    a skos:Concept ;
    skos:inScheme bank:SchemeProcess ;
    skos:broader bank:ServicingProcess ;
    skos:prefLabel "Loan disbursement"@en ;
    skos:altLabel "Disbursement"@en, "Drawdown"@en, "Loan payout"@en ;
    skos:definition "The process of releasing approved loan funds to the customer or a designated payee after all conditions precedent have been met."@en .

bank:DebtCollection
    a skos:Concept ;
    skos:inScheme bank:SchemeProcess ;
    skos:broader bank:ServicingProcess ;
    skos:prefLabel "Debt collection"@en ;
    skos:altLabel "Collections"@en, "Recovery"@en, "Arrears management"@en ;
    skos:definition "The process of recovering overdue loan payments from borrowers who are delinquent or have defaulted on their credit obligations."@en .

bank:LoanRestructuring
    a skos:Concept ;
    skos:inScheme bank:SchemeProcess ;
    skos:broader bank:ServicingProcess ;
    skos:prefLabel "Loan restructuring"@en ;
    skos:altLabel "Restructuring"@en, "Loan modification"@en, "Forbearance"@en ;
    skos:definition "The modification of the original terms of a loan — such as repayment schedule, interest rate, or maturity — to accommodate a borrower experiencing financial difficulty."@en .


# --------------------------------------------------------------------------
# SCHEME 4 (continued): RISK — credit risk metrics and statuses
# --------------------------------------------------------------------------

bank:CreditRisk
    a skos:Concept ;
    skos:inScheme bank:SchemeRisk ;
    skos:broader bank:RiskAssessment ;
    skos:prefLabel "Credit risk"@en ;
    skos:altLabel "Default risk"@en, "Counterparty risk"@en ;
    skos:definition "The risk that a borrower will fail to meet contractual repayment obligations, resulting in financial loss to the bank."@en .

bank:OperationalRisk
    a skos:Concept ;
    skos:inScheme bank:SchemeRisk ;
    skos:broader bank:RiskAssessment ;
    skos:prefLabel "Operational risk"@en ;
    skos:definition "The risk of loss resulting from inadequate or failed internal processes, systems, people, or external events."@en .

bank:Collateral
    a skos:Concept ;
    skos:inScheme bank:SchemeRisk ;
    skos:broader bank:CreditRisk ;
    skos:prefLabel "Collateral"@en ;
    skos:altLabel "Security"@en, "Pledge"@en, "Loan security"@en ;
    skos:definition "An asset pledged by a borrower to secure a credit obligation, which the bank may seize in the event of default."@en .

bank:DTI
    a skos:Concept ;
    skos:inScheme bank:SchemeRisk ;
    skos:broader bank:CreditRisk ;
    skos:prefLabel "Debt-to-income ratio"@en ;
    skos:altLabel "DTI"@en, "DTI ratio"@en ;
    skos:definition "A metric expressing a borrower's total monthly debt obligations as a percentage of gross monthly income, used to assess repayment capacity."@en .

bank:LTV
    a skos:Concept ;
    skos:inScheme bank:SchemeRisk ;
    skos:broader bank:CreditRisk ;
    skos:prefLabel "Loan-to-value ratio"@en ;
    skos:altLabel "LTV"@en, "LTV ratio"@en ;
    skos:definition "The ratio of a loan amount to the appraised value of the collateral asset, used to assess collateral coverage and credit risk."@en .

bank:Delinquency
    a skos:Concept ;
    skos:inScheme bank:SchemeRisk ;
    skos:broader bank:CreditRisk ;
    skos:prefLabel "Delinquency"@en ;
    skos:altLabel "Arrears"@en, "Past due"@en, "Overdue"@en ;
    skos:definition "A status indicating that a borrower has failed to make one or more scheduled loan repayments by the contractual due date."@en .

bank:Default
    a skos:Concept ;
    skos:inScheme bank:SchemeRisk ;
    skos:broader bank:CreditRisk ;
    skos:prefLabel "Default"@en ;
    skos:altLabel "Loan default"@en, "Credit default"@en ;
    skos:definition "A formal status triggered when a borrower fails to meet the repayment terms of a credit agreement, typically after a defined number of days past due."@en .

bank:NPL
    a skos:Concept ;
    skos:inScheme bank:SchemeRisk ;
    skos:broader bank:CreditRisk ;
    skos:prefLabel "Non-performing loan"@en ;
    skos:altLabel "NPL"@en, "Bad loan"@en, "Non-performing exposure"@en ;
    skos:definition "A loan classified as non-performing when scheduled principal or interest payments are more than 90 days past due or repayment is considered unlikely."@en .

bank:ProbabilityOfDefault
    a skos:Concept ;
    skos:inScheme bank:SchemeRisk ;
    skos:broader bank:CreditRisk ;
    skos:prefLabel "Probability of default"@en ;
    skos:altLabel "PD"@en, "PD score"@en ;
    skos:definition "A statistical estimate of the likelihood that a borrower will default on a credit obligation within a defined time horizon, typically one year."@en .


# --------------------------------------------------------------------------
# SCHEME 5 (continued): DOCUMENT — loan and compliance documents
# --------------------------------------------------------------------------

bank:LoanAgreement
    a skos:Concept ;
    skos:inScheme bank:SchemeDocument ;
    skos:broader bank:Contract ;
    skos:prefLabel "Loan agreement"@en ;
    skos:altLabel "Credit agreement"@en, "Loan contract"@en ;
    skos:definition "A legally binding contract between the bank and a borrower specifying the loan amount, interest rate, repayment schedule, and obligations of both parties."@en .

bank:CreditReport
    a skos:Concept ;
    skos:inScheme bank:SchemeDocument ;
    skos:broader bank:Document ;
    skos:prefLabel "Credit report"@en ;
    skos:altLabel "Credit bureau report"@en, "Credit history"@en ;
    skos:definition "A document issued by a credit bureau summarising a borrower's credit history, outstanding obligations, and payment behaviour."@en .

bank:ApplicationForm
    a skos:Concept ;
    skos:inScheme bank:SchemeDocument ;
    skos:broader bank:Document ;
    skos:prefLabel "Application form"@en ;
    skos:altLabel "Loan application form"@en, "Credit application"@en ;
    skos:definition "A structured document completed by a customer to formally request a financial product, containing personal, financial, and employment information."@en .

bank:TermsAndConditions
    a skos:Concept ;
    skos:inScheme bank:SchemeDocument ;
    skos:broader bank:Contract ;
    skos:prefLabel "Terms and conditions"@en ;
    skos:altLabel "T&C"@en, "General terms"@en, "Product terms"@en ;
    skos:definition "A document setting out the contractual rules and obligations governing a financial product or service offered by the bank."@en .


# --------------------------------------------------------------------------
# SCHEME 6 (continued): CHANNEL — additional access channels
# --------------------------------------------------------------------------

bank:ATM
    a skos:Concept ;
    skos:inScheme bank:SchemeChannel ;
    skos:broader bank:Channel ;
    skos:prefLabel "ATM"@en ;
    skos:altLabel "Automated teller machine"@en, "Cash machine"@en ;
    skos:definition "A self-service electronic terminal that allows customers to perform basic banking transactions such as cash withdrawals, deposits, and balance enquiries."@en .

bank:PartnerChannel
    a skos:Concept ;
    skos:inScheme bank:SchemeChannel ;
    skos:broader bank:Channel ;
    skos:prefLabel "Partner channel"@en ;
    skos:altLabel "Agent channel"@en, "Third-party channel"@en, "Broker channel"@en ;
    skos:definition "A distribution channel in which the bank's products are offered through an authorised third-party intermediary such as a broker, agent, or retail partner."@en .


# ==========================================================================
# ADDITIONAL RELATION INSTANCES (v0.2)
# ==========================================================================

bank:Guarantor          bank-rel:submits     bank:LoanApplication .
bank:CoBorrower         bank-rel:submits     bank:LoanApplication .
bank:Mortgage           bank-rel:requires    bank:Collateral .
bank:Mortgage           bank-rel:requires    bank:LoanAgreement .
bank:CDD                bank-rel:evaluates   bank:BeneficialOwner .
bank:EDD                bank-rel:evaluates   bank:PEP .
bank:AMLProcess         bank-rel:triggers    bank:SanctionsScreening .
bank:AMLProcess         bank-rel:triggers    bank:CDD .
bank:Underwriting       bank-rel:produces    bank:CreditDecision .
bank:Underwriting       bank-rel:evaluates   bank:DTI .
bank:CreditDecision     bank-rel:governs     bank:LoanDisbursement .
bank:LoanDisbursement   bank-rel:produces    bank:LoanAgreement .
bank:DebtCollection     bank-rel:evaluates   bank:Delinquency .
bank:CreditCheck        bank-rel:produces    bank:ProbabilityOfDefault .


