# OntoBridge environment variables
# Copy this file to .env and fill in the values.
# Never commit .env to Git.

# ── Core ──────────────────────────────────────────────────────────────────────

# Path to your SKOS/OWL ontology file (defaults to the bundled baseline)
# ONTOLOGY_PATH=ontology/ontobridge_ontology_v0.1.ttl

# Path to the SQLite database file (omit for in-memory demo mode)
# DB_PATH=ontobridge.db

# ── Security ──────────────────────────────────────────────────────────────────

# API key required on all /api/* routes (leave unset to disable auth in local dev)
# ONTOBRIDGE_API_KEY=your-secret-key

# Allowed CORS origins, comma-separated (defaults to * when unset)
# CORS_ORIGINS=https://yourapp.example.com,https://catalog.example.com

# ── LLM backends ──────────────────────────────────────────────────────────────

# Anthropic Claude API key (required for Claude-based LLM extraction)
# ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Embeddings ────────────────────────────────────────────────────────────────

# Set to 0 to force TF-IDF placement/dedup and skip sentence-transformers download
# ONTOBRIDGE_EMBEDDINGS=1

# ── Webhooks ──────────────────────────────────────────────────────────────────

# POST target fired on every term lifecycle change
# ONTOBRIDGE_WEBHOOK_URL=https://catalog.example.com/hooks/ontobridge

# Optional HMAC secret for webhook payload signing
# ONTOBRIDGE_WEBHOOK_SECRET=shared-secret

# ── Dawiso integration ────────────────────────────────────────────────────────

# Base URL of your Dawiso instance
# DAWISO_URL=https://your-instance.dawiso.com

# Dawiso authentication (obtain from your Dawiso admin)
# DAWISO_JWT=eyJ...
# DAWISO_SESSION_ID=...
# DAWISO_APP_ID=...
# DAWISO_SPACE_ID=...

# ── MCP server ────────────────────────────────────────────────────────────────

# OntoBridge API base URL used by the MCP server
# ONTOBRIDGE_URL=http://localhost:8001

# Port for the MCP SSE server (default: 8002)
# MCP_PORT=8002
